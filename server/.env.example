# ─────────────────────────────────────────────────────────────
# Configuración del API (copiar a .env y ajustar)
# ─────────────────────────────────────────────────────────────
APP_ENV=development
API_PORT=8081

# Postgres 17 (docker compose expone 5433 para no chocar con 5432)
POSTGRES_USER=credit_store
POSTGRES_PASSWORD=credit_store
POSTGRES_DB=credit_store
POSTGRES_PORT=5433
DATABASE_URL=postgres://credit_store:credit_store@localhost:5433/credit_store?sslmode=disable

# Seguridad: JWT_SECRET debe tener mínimo 32 caracteres
JWT_SECRET=dev-secret-change-me-please-0123456789abcdef
JWT_ISSUER=credit-store-api
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
BCRYPT_COST=12

# CORS: orígenes exactos para producción (en desarrollo se permite localhost)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Migraciones y datos de prueba al iniciar
AUTO_MIGRATE=true
SEED_ON_START=true

# Carpeta de fotos de productos (se sirve en /downloads)
DOWNLOADS_DIR=./downloads
SEED_PASSWORD=123456

LOG_LEVEL=info
