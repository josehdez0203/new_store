# ─────────────────────────────────────────────────────────────
# CrediStore · producción con Nginx existente
# Copia este archivo a deploy/.env y completa los valores.
# ─────────────────────────────────────────────────────────────

# Base de datos PostgreSQL.
# Usa una contraseña larga y compatible con URL (sin @, :, /, # ni espacios).
POSTGRES_USER=credit_store
POSTGRES_PASSWORD=CAMBIA_ESTA_CONTRASENA_URL_SAFE
API_DB_NAME=api-store
XAPARI_DB_NAME=xapari

# API.
APP_ENV=production
API_PORT=8081
# Puerto del host al que Nginx hará proxy (127.0.0.1).
API_HOST_PORT=8081
JWT_SECRET=CAMBIA_ESTO_POR_UN_SECRETO_ALEATORIO_DE_64_CARACTERES
JWT_ISSUER=credit-store-api
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
BCRYPT_COST=12
# Origen(es) exactos del frontend Flutter web separados por coma.
# Si sirves Flutter desde el mismo dominio del API:
# CORS_ORIGINS=https://api-store.jhc-sistemas.com
CORS_ORIGINS=https://app.example.com
AUTO_MIGRATE=true
SEED_ON_START=false
SEED_PASSWORD=CAMBIA_LA_CONTRASENA_INICIAL_DEL_ADMIN
DOWNLOADS_DIR=/data/downloads
LOG_LEVEL=info

# Zona horaria de los logs del API.
TZ=America/Mexico_City
